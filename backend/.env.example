# Copy to .env and fill in your values

# Set to "production" to enable hard startup checks that refuse to run with
# insecure defaults (default SECRET_KEY, "*" admin list, default DB creds).
# Leave as "development" for local work.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chat

# ⚠  IMPORTANT: Change this to a strong, unique value!
#    Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
#    A warning is printed at startup if the default is still in use, and the
#    app will refuse to start with ENVIRONMENT=production.
SECRET_KEY=change-me-in-production
# Access tokens are short-lived on purpose; the rotating refresh token keeps
# users signed in. Production refuses values above 60.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Browsers get the refresh token as an HttpOnly cookie (not readable by page
# script). Its Path must be where the browser sees the auth routes: /api/auth
# behind the bundled nginx. Secure is set automatically on HTTPS requests
# (X-Forwarded-Proto); force it with true/false if your proxy doesn't say.
# REFRESH_COOKIE_PATH=/api/auth
# REFRESH_COOKIE_SECURE=

# Comma-separated list of user IDs allowed to generate decoration codes.
# Set to "*" (default) to allow any authenticated user (dev mode).
# In production, restrict to specific admin user UUIDs.
# DECORATION_ADMIN_IDS=*
