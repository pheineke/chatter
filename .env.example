# Copy to .env (same directory as docker-compose.yml) to override the
# defaults baked into docker-compose.yml. docker compose loads this file
# automatically. Not needed for local dev — only for anything deployed
# somewhere reachable by others.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=chat

# --- Backend --------------------------------------------------------------
# Set to "production" to make the backend refuse to start if any of the
# secrets below are still at their insecure defaults.
ENVIRONMENT=production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# Comma-separated admin user UUIDs. Leave unset only for local/dev use.
DECORATION_ADMIN_IDS=
