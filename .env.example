# Copy to .env (same directory as docker-compose.yml) to override the
# defaults baked into docker-compose.yml. docker compose loads this file
# automatically. Not needed for local dev — only for anything deployed
# somewhere reachable by others.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=chat

# --- Backend --------------------------------------------------------------
# Set to "production" to make the backend refuse to start if any of the
# secrets below are still at their insecure defaults.
ENVIRONMENT=production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# Comma-separated admin user UUIDs. Leave unset only for local/dev use.
DECORATION_ADMIN_IDS=

# Who may sign up: open | invite | closed. With "invite", a valid server
# invite code is required (the first account on an empty instance is exempt,
# so you can create yours). docker-compose.prod.yml defaults to invite.
REGISTRATION_MODE=invite

# --- Public deployment with HTTPS (docker-compose.prod.yml) ----------------
# Use the prod overlay with plain `docker compose` commands:
# Behind a Cloudflare Tunnel (cloudflared on the host) use instead:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.cloudflared.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Public hostname; its DNS must point here and ports 80/443 must be reachable
# so Caddy can get a Let's Encrypt certificate.
DOMAIN=chat.example.org

# Without the prod overlay: host port nginx listens on (plain HTTP).
# HTTP_PORT=9090

# --- Backups (scripts/backup.sh) ---------------------------------------------
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
